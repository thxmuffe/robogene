@base = {{$processEnv ROBOGENE_API_BASE}}

@sagaId = e2e-saga
@rosterId = e2e-roster
@chapterId = e2e-chapter
@chapterFrameId = e2e-chapter-frame-1
@characterId = e2e-character
@characterFrameId = e2e-character-frame-1

### Seed saga board
POST {{base}}/api/entity
Content-Type: application/json

{
  "id": "{{sagaId}}",
  "vanityRole": "saga",
  "title": "Smoke Test Saga",
  "description": "A test saga for E2E runs",
  "children": ["{{chapterId}}"],
  "payload": {}
}

### Seed roster board
POST {{base}}/api/entity
Content-Type: application/json

{
  "id": "{{rosterId}}",
  "vanityRole": "roster",
  "title": "Test Roster",
  "description": "A roster for E2E runs",
  "children": ["{{characterId}}"],
  "payload": {}
}

### Seed saga child sequence
POST {{base}}/api/entity
Content-Type: application/json

{
  "id": "{{chapterId}}",
  "vanityRole": "chapter",
  "title": "Smoke Chapter",
  "description": "A deterministic chapter for local E2E runs.",
  "children": ["{{chapterFrameId}}"],
  "payload": {
    "parentId": "{{sagaId}}",
    "sagaId": "{{sagaId}}",
    "rosterId": "{{rosterId}}",
    "rosterIds": ["{{rosterId}}"]
  }
}

### Seed roster child sequence
POST {{base}}/api/entity
Content-Type: application/json

{
  "id": "{{characterId}}",
  "vanityRole": "character",
  "title": "Seed Character",
  "description": "Initial alias text",
  "children": ["{{characterFrameId}}"],
  "payload": {
    "parentId": "{{rosterId}}",
    "rosterId": "{{rosterId}}"
  }
}

### Seed chapter frame
POST {{base}}/api/entity
Content-Type: application/json

{
  "id": "{{chapterFrameId}}",
  "vanityRole": "frame",
  "title": "Frame 1",
  "description": "Seed frame",
  "children": [],
  "payload": {
    "parentId": "{{chapterId}}",
    "ownerId": "{{chapterId}}",
    "ownerType": "saga",
    "frameNumber": 1,
    "imageStatus": "draft",
    "imageUrl": null
  }
}

### Seed character frame
POST {{base}}/api/entity
Content-Type: application/json

{
  "id": "{{characterFrameId}}",
  "vanityRole": "frame",
  "title": "Frame 1",
  "description": "Seed character frame",
  "children": [],
  "payload": {
    "parentId": "{{characterId}}",
    "ownerId": "{{characterId}}",
    "ownerType": "character",
    "frameNumber": 1,
    "imageStatus": "draft",
    "imageUrl": null
  }
}
