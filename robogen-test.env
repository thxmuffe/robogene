# Overlay env for test runs. This file is merged on top of the inherited process env.
# Some values below intentionally look redundant because Azure Functions and app code
# read different variable names for the same setting, and tests must override both.

ROBOGENE_IMAGE_GENERATOR='mock'
# Both storage keys must point to Azurite during tests:
# - ROBOGENE_STORAGE_CONNECTION_STRING is the app's preferred lookup
# - AzureWebJobsStorage is still used by Azure Functions tooling/runtime
ROBOGENE_STORAGE_CONNECTION_STRING='UseDevelopmentStorage=true'
AzureWebJobsStorage='UseDevelopmentStorage=true'
ROBOGENE_ALLOW_DEV_STORAGE_FOR_SMOKE='1'
ROBOGENE_E2E_SEED_FILE='tests/fixtures/e2e-seed.http'

# Use separate API ports for e2e test hosts.
ROBOGENE_E2E_PORT='7181'
ROBOGENE_E2E_IMAGE_PORT='7182'

# Optional: tune test timeouts and polling behavior.
ROBOGENE_E2E_TIMEOUT_MS='5000'
ROBOGENE_IMAGE_GEN_TIMEOUT_MS='180000'
ROBOGENE_IMAGE_GEN_POLL_MS='2000'

# The browser app must hit the isolated e2e API host, not the default local dev port.
ROBOGENE_API_BASE='http://127.0.0.1:7181'
