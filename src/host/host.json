{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Worker": "Information",
      "Function": "Warning",
      "Function.get-state.User": "Information",
      "Function.post-entity.User": "Information",
      "Function.patch-entity.User": "Information",
      "Function.delete-entity.User": "Information",
      "Function.post-generate-frame.User": "Information",
      "Function.signalr-negotiate.User": "Information",
      "Function.options-preflight.User": "Information",
      "Microsoft": "Warning",
      "Host": "Warning",
      "Host.Results": "Error",
      "Host.Aggregator": "Error"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "ROBOGENE_IMAGE_GENERATOR": "openai",
  "IMAGE_GENERATORS": [
    {
      "name": "openai",
      "apiKeyEnv": "OPENAI_API_KEY",
      "model": "gpt-image-1-mini",
      "quality": "low",
      "size": "1024x1024"
    },
    {
      "name": "mock",
      "dataUrl": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO7+Jc8AAAAASUVORK5CYII="
    }
  ]
}
